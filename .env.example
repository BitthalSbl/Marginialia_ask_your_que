# EVERYTHING HERE IS OPTIONAL. With no .env at all the app runs in offline mode (keyword search,
# answers quoted from your PDFs). Add a key to upgrade to AI-written answers + semantic search.

# auto = Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else offline.
LLM_PROVIDER=auto

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=

DATA_DIR=./data
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=15
